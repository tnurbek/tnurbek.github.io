<div class="repo p-2">
  <article class="repo-card" data-repo="{{ include.repository }}">
    <div class="repo-card-top">
      <a class="repo-card-name" href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
        {{ include.repository }}
      </a>
      <a class="repo-card-open" href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ include.repository }}">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>
    </div>
    <p class="repo-card-desc">Loading repository details...</p>
    <div class="repo-card-meta">
      <span class="repo-card-pill"><i class="fa-regular fa-star"></i> <span data-field="stars">--</span></span>
      <span class="repo-card-pill"><i class="fa-solid fa-code-fork"></i> <span data-field="forks">--</span></span>
      <span class="repo-card-pill"><i class="fa-regular fa-circle"></i> <span data-field="language">--</span></span>
    </div>
  </article>
</div>
